# Speed up zsh startup
DISABLE_AUTO_UPDATE="true"
DISABLE_MAGIC_FUNCTIONS="true"
DISABLE_COMPFIX="true"
skip_global_compinit=1

# If you come from bash you might have to change your $PATH.
export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

{{- if eq .chezmoi.os "darwin" }}
# macOS: bring Homebrew (Apple Silicon default prefix) onto PATH early so the
# guarded tool inits below can find brew-installed binaries.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi
{{- else }}
# Linux: Homebrew (linuxbrew) if present.
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi
{{- end }}

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="robbyrussell"

# Stop oh-my-zsh from setting the tab title to the running command.
# Must be set BEFORE `source $ZSH/oh-my-zsh.sh`.
DISABLE_AUTO_TITLE="true"

SPACESHIP_PROMPT_ASYNC=true
SPACESHIP_PROMPT_ADD_NEWLINE=true
SPACESHIP_CHAR_SYMBOL="⚡"

plugins=(git z zsh-autosuggestions zsh-syntax-highlighting  zsh-history-substring-search)

[[ -f $ZSH/oh-my-zsh.sh ]] && source $ZSH/oh-my-zsh.sh

ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE="20"
ZSH_AUTOSUGGEST_USE_ASYNC=1

# compinit - only rebuild once per day
fpath=(~/.completions $fpath)
autoload -Uz compinit
setopt extendedglob
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi

# User configuration
# Cache eval outputs for faster startup
_zsh_cache_eval() {
  local name="$1" cmd="$2"
  local cache_file="$HOME/.zshcache/${name}.zsh"
  if [[ ! -f "$cache_file" ]] || [[ ! -s "$cache_file" ]]; then
    mkdir -p "$HOME/.zshcache"
    eval "$cmd" > "$cache_file"
  fi
  source "$cache_file"
}

[[ -f "$HOME/.atuin/bin/env" ]] && . "$HOME/.atuin/bin/env"
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

command -v starship       >/dev/null 2>&1 && _zsh_cache_eval "starship" "starship init zsh"
command -v atuin          >/dev/null 2>&1 && _zsh_cache_eval "atuin" "atuin init zsh"
command -v fzf            >/dev/null 2>&1 && _zsh_cache_eval "fzf" "fzf --zsh"
command -v dstask         >/dev/null 2>&1 && _zsh_cache_eval "dstask" "dstask zsh-completion"
command -v intelli-shell  >/dev/null 2>&1 && _zsh_cache_eval "intelli-shell" "intelli-shell init zsh"
command -v mise           >/dev/null 2>&1 && _zsh_cache_eval "mise" "mise activate zsh"
command -v zoxide         >/dev/null 2>&1 && _zsh_cache_eval "zoxide" "zoxide init zsh"
export EDITOR=nvim

# Lazy load NVM (which is notorious for slow startup)
export NVM_DIR="$HOME/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  function nvm() {
    unset -f nvm node npm npx
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
    nvm use default >/dev/null 2>&1 || true
    nvm "$@"
  }

  function node() { nvm >/dev/null 2>&1 && node "$@"; }
  function npm() { nvm >/dev/null 2>&1 && npm "$@"; }
  function npx() { nvm >/dev/null 2>&1 && npx "$@"; }
fi

# IntelliShell
if command -v intelli-shell >/dev/null 2>&1; then
  export INTELLI_HOME="$HOME/.local/share/intelli-shell"
  export PATH="$INTELLI_HOME/bin:$PATH"
fi

function set_git_title() {
    if git rev-parse --show-toplevel &>/dev/null; then
        repo=$(basename "$(git rev-parse --show-toplevel)")
    else
        repo=$(basename "$PWD")
    fi
    print -Pn "\e]0;$repo\a"
}

precmd() { set_git_title }

# Always route opencode through Headroom proxy.
# Bypass with:  command opencode
if command -v headroom >/dev/null 2>&1; then
  opencode() {
    headroom wrap opencode -- "$@"
  }
fi

# Machine-specific overrides (work email git include target, host-specific PATH,
# secrets sourced from a private file, etc). NOT managed by chezmoi (see .chezmoiignore).
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
